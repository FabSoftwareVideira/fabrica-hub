PROJECT_NAME=fabrica-hub
PORT=3000
APP_ENV=development
APP_VERSION=dev
SESSION_SECRET=dev-secret-troque-em-producao

# Endereço público do hub (em produção, o domínio HTTPS configurado no Dokploy)
APP_URL=http://localhost:3010

# Login com Google (só a área administrativa usa login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3010/auth/google/callback

# Primeira conta com acesso à área administrativa; ela autoriza as demais
ADMIN_PRINCIPAL_EMAIL=fabricadesoftware.videira@ifc.edu.br

POSTGRES_HOST=hub-db
POSTGRES_PORT=5432
POSTGRES_USER=appuser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hub-db

# Listagem automática das aplicações publicadas no Dokploy (opcional).
# Sem as duas variáveis, o hub funciona só com o cadastro manual.
#   DOKPLOY_URL      endereço do painel, ex.: https://dokploy.exemplo.br
#   DOKPLOY_API_KEY  token de um usuário do Dokploy (de preferência só de leitura; veja o README)
DOKPLOY_URL=
DOKPLOY_API_KEY=
# De quantos em quantos minutos procurar aplicações novas (0 = só pelo botão da área administrativa)
DOKPLOY_SINCRONIZAR_MINUTOS=30

# De quantos em quantos segundos conferir se as aplicações estão no ar
STATUS_INTERVALO_SEGUNDOS=60

# Backup diário do banco no Dokploy (opcionais; horário de Brasília)
BACKUP_HOST_DIR=/srv/fabrica-hub/backups
BACKUP_HORA=03:00
BACKUP_RETENCAO_DIAS=14
